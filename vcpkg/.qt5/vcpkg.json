{
  "vcpkg-configuration": {
    "default-registry": {
      "kind": "git",
      "baseline": "dd930e314f529c86d2703a60d5ea7dd6573d9e5a",
      "repository": "https://github.com/microsoft/vcpkg"
    },
    "registries": [
      {
        "kind": "git",
        "baseline": "6ede4a1108756899e55fe4d308aaa25410e8e12f",
        "repository": "https://github.com/open-vcpkg/qt5-registry",
        "packages": [
          "py-pyqt5",
          "py-pyqt5-sip",
          "py-qscintilla-qt5",
          "qscintilla-qt5",
          "qt5-webkit",
          "vcpkg-qmake-qt5"
        ]
      },
      {
        "kind": "git",
        "baseline": "589b997f822169a6399ba275640e8ddd63d43461",
        "repository": "https://github.com/open-vcpkg/python-registry",
        "packages": [
          "arrow",
          "python3",
          "py-*",
          "gdal",
          "vcpkg-python-scripts",
          "vcpkg-tool-mercurial",
          "vcpkg-tool-rust",
          "pybind11"
        ]
      }
    ],
    "overlay-ports": [
      "../ports"
    ],
    "overlay-triplets": [
      "../triplets"
    ]
  },
  "name": "qgis",
  "version-string": "current",
  "description": "QGIS is a free, open source, cross platform (lin/win/mac) geographical information system (GIS)",
  "homepage": "https://qgis.org",
  "dependencies": [
    "draco",
    "duckdb",
    {
      "name": "exiv2",
      "features": [
        "xmp"
      ]
    },
    "expat",
    {
      "name": "gdal",
      "features": [
        "arrow-adbc",
        "freexl",
        "kea",
        "parquet",
        "poppler",
        "tools"
      ]
    },
    "geos",
    "gsl",
    "jhasse-poly2tri",
    "libpq",
    "libspatialindex",
    "libspatialite",
    {
      "name": "libtasn1",
      "platform": "ios | osx"
    },
    "libxml2",
    "libzip",
    "meshoptimizer",
    "nlohmann-json",
    "o2-qt5",
    "opencl",
    "pdal",
    "proj",
    "protobuf",
    "py-psycopg2",
    "python3",
    {
      "name": "qca-qt5",
      "default-features": false,
      "features": [
        "ossl"
      ]
    },
    "qt5-base",
    "qt5-location",
    {
      "name": "qt5-macextras",
      "platform": "osx"
    },
    "qt5-multimedia",
    "qt5-svg",
    "qt5-tools",
    "qt5-webkit",
    {
      "name": "qt5-winextras",
      "platform": "windows"
    },
    "qtkeychain",
    {
      "name": "tiff",
      "features": [
        "lerc",
        "libdeflate",
        "webp",
        "zstd"
      ]
    },
    "zlib"
  ],
  "features": {
    "3d": {
      "description": "Determines whether QGIS 3D library should be built",
      "dependencies": [
        "qt5-3d"
      ]
    },
    "bindings": {
      "description": "Determines whether Python bindings should be built",
      "dependencies": [
        {
          "name": "arrow",
          "features": [
            "python"
          ],
          "platform": "!windows"
        },
        {
          "name": "arrow",
          "platform": "windows"
        },
        {
          "name": "gdal",
          "features": [
            "python"
          ]
        },
        {
          "name": "py-adbc-postgresql",
          "platform": "!windows"
        },
        {
          "name": "py-adbc-sqlite",
          "platform": "!windows"
        },
        "py-attrs",
        "py-autopep8",
        "py-beautifulsoup4",
        "py-dateutil",
        "py-duckdb",
        {
          "name": "py-geopandas",
          "features": [
            "fiona",
            "arrow"
          ],
          "platform": "!windows"
        },
        "py-isort",
        "py-jinja2",
        {
          "name": "py-jsonschema",
          "platform": "!windows"
        },
        "py-lxml",
        "py-matplotlib",
        "py-markupsafe",
        "py-networkx",
        "py-numpy",
        "py-owslib",
        "py-pip",
        "py-plotly",
        "py-psycopg",
        "py-psycopg2",
        {
          "name": "py-pydantic",
          "platform": "!windows"
        },
        "py-pyproj",
        {
          "name": "py-pyqt5",
          "features": [
            "3d"
          ]
        },
        "py-pysal",
        "py-pytz",
        "py-pyyaml",
        "py-qscintilla-qt5",
        "py-rasterio",
        "py-requests",
        {
          "name": "py-scipy",
          "platform": "!windows"
        },
        "py-shapely",
        "py-six",
        "py-urllib3",
        "python3"
      ]
    },
    "gui": {
      "description": "Determines whether the QGIS gui should be built",
      "dependencies": [
        "qscintilla-qt5",
        "qwt-qt5"
      ]
    },
    "opencl": {
      "description": "Should OpenCL support be added",
      "dependencies": [
        "opencl"
      ]
    },
    "oracle": {
      "description": "Build with oracle support",
      "dependencies": [
        "oracle-instantclient"
      ]
    },
    "proj-data": {
      "description": "Build with proj data",
      "dependencies": [
        "proj-data"
      ]
    },
    "server": {
      "description": "Determines whether QGIS server should be built",
      "dependencies": [
        "fastcgi"
      ]
    }
  }
}
