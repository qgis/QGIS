{
  "vcpkg-configuration": {
    "default-registry": {
      "kind": "git",
      "baseline": "e3ed41868d5034bc608eaaa58383cd6ecdbb5ffb",
      "repository": "https://github.com/microsoft/vcpkg"
    },
    "registries": [
      {
        "kind": "git",
        "baseline": "6ede4a1108756899e55fe4d308aaa25410e8e12f",
        "repository": "https://github.com/open-vcpkg/qt5-registry",
        "packages": [
          "py-pyqt5",
          "py-pyqt5-sip",
          "py-qscintilla-qt5",
          "qscintilla-qt5",
          "qt5-webkit",
          "vcpkg-qmake-qt5"
        ]
      },
      {
        "kind": "git",
        "baseline": "1e4af3021fb7522619abe65507ec3716c39cd79a",
        "repository": "https://github.com/open-vcpkg/python-registry",
        "packages": [
          "python3",
          "py-*",
          "gdal",
          "swig",
          "vcpkg-python-scripts",
          "vcpkg-tool-mercurial",
          "pybind11"
        ]
      }
    ],
    "overlay-ports": [
      "../ports"
    ],
    "overlay-triplets": [
      "../triplets"
    ]
  },
  "name": "qgis",
  "version-string": "current",
  "description": "QGIS is a free, open source, cross platform (lin/win/mac) geographical information system (GIS)",
  "homepage": "https://qgis.org",
  "dependencies": [
    "duckdb",
    "draco",
    {
      "name": "exiv2",
      "features": [
        "xmp"
      ]
    },
    "expat",
    "py-psycopg2",
    "python3",
    {
      "name": "gdal",
      "features": [
        "arrow-adbc",
        "freexl",
        "kea",
        "parquet",
        "poppler",
        "tools"
      ]
    },
    "geos",
    "gsl",
    "jhasse-poly2tri",
    "libpq",
    "libspatialindex",
    "libspatialite",
    {
      "name": "libtasn1",
      "platform": "ios | osx"
    },
    "libxml2",
    "libzip",
    "meshoptimizer",
    "nlohmann-json",
    "o2-qt5",
    "opencl",
    "pdal",
    "proj",
    "protobuf",
    {
      "name": "qca-qt5",
      "default-features": false,
      "features": [
        "ossl"
      ]
    },
    "qt5-base",
    "qt5-location",
    {
      "name": "qt5-macextras",
      "platform": "osx"
    },
    "qt5-multimedia",
    "qt5-svg",
    "qt5-tools",
    {
      "name": "qt5-winextras",
      "platform": "windows"
    },
    "qtkeychain",
    "zlib"
  ],
  "features": {
    "3d": {
      "description": "Determines whether QGIS 3D library should be built",
      "dependencies": [
        "qt5-3d"
      ]
    },
    "bindings": {
      "description": "Determines whether Python bindings should be built",
      "dependencies": [
        {
          "name": "gdal",
          "features": [
            "python"
          ]
        },
        "py-autopep8",
        "py-dateutil",
        "py-duckdb",
        "py-isort",
        "py-jinja2",
        "py-lxml",
        "py-markupsafe",
        "py-numpy",
        "py-owslib",
        "py-pip",
        "py-psycopg",
        "py-psycopg2",
        "py-pydantic",
        {
          "name": "py-pyqt5",
          "features": [
            "3d"
          ]
        },
        "py-qscintilla-qt5",
        "py-pytz",
        "py-pyyaml",
        "py-requests",
        "py-six",
        "python3"
      ]
    },
    "gui": {
      "description": "Determines whether the QGIS gui should be built",
      "dependencies": [
        "qscintilla-qt5",
        "qwt-qt5"
      ]
    },
    "opencl": {
      "description": "Should OpenCL support be added",
      "dependencies": [
        "opencl"
      ]
    },
    "oracle": {
      "description": "Build with oracle support",
      "dependencies": [
        "oracle-instantclient"
      ]
    },
    "server": {
      "description": "Determines whether QGIS server should be built",
      "dependencies": [
        "fastcgi"
      ]
    }
  }
}
