class QgsLabelSearchTree
{
%Docstring(signature="appended")
Queries the labeling structure at a given point.

This class is a small wrapper around the pal RTree class.
%End

%TypeHeaderCode
#include "qgslabelsearchtree.h"
%End
  public:
    QgsLabelSearchTree();
    ~QgsLabelSearchTree();


