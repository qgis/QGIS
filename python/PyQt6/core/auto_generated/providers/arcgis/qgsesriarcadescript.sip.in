class QgsEsriArcadeMemberAccessExpression : QgsEsriArcadeExpression
{
%Docstring(signature="appended")
Represents a member access expression using dot or bracket notation.

For example ``$feature.ATTRIBUTE.`` or ``my_dict["ATTRIBUTE"]`` for
accessing members of a dictionary.

Arcade also supports a "?." accessor which performs a "safe access",
where null values are returned when the container itself is null. For
these "?." forms :py:func:`~isSafeAccess` will return ``True``.

.. versionadded:: 4.4
%End

%TypeHeaderCode
#include "qgsesriarcadescript.h"
%End
  public:
    QgsEsriArcadeMemberAccessExpression( QgsEsriArcadeExpression *containerExpression /Transfer/, const QString &memberName, bool isSafeAccess = false );
%Docstring
Constructor for QgsEsriArcadeMemberAccessExpression.

Ownership of ``containerExpression`` is transferred to this expression.
%End

    virtual QgsEsriArcadeNode::NodeType nodeType() const;
    virtual QString dump() const;

    virtual QgsEsriArcadeNode *clone() const /Factory/;

    virtual void accept( QgsEsriArcadeVisitor &visitor ) const;


    QgsEsriArcadeExpression *containerExpression() const;
%Docstring
Returns the container expression being accessed.
%End

    QString memberName() const;
%Docstring
Returns the member attribute name.
%End

    bool isSafeAccess() const;
%Docstring
Returns ``True`` if member access uses the safe access operator "?.".
%End

    void setIsSafeAccess( bool isSafeAccess );
%Docstring
Sets whether member access uses the safe access operator "?.".
%End

  private:
    QgsEsriArcadeMemberAccessExpression( const QgsEsriArcadeMemberAccessExpression &other );
};

