class QgsEsriArcadeConverter
{
%Docstring(signature="appended")
Converts an Esri Arcade script to a :py:class:`QgsExpression`.

.. versionadded:: 4.4
%End

%TypeHeaderCode
#include "qgsesriarcadeconverter.h"
%End
  public:
    enum class Result
    {
      Success,
      ParserError,
      InvalidScriptMultiStatements,
      InvalidScriptIncompatible,
      UnknownError,
    };

    QgsEsriArcadeConverter( const QString &script );
%Docstring
Constructor for QgsEsriArcadeConverter for converting the specified
``script``.
%End

    Result result() const;
%Docstring
Returns the result of converting the script.

If the conversion was not successful, a descriptive error can be
