class QgsHtmlRenderSettings
{
%Docstring(signature="appended")
Encapsulates settings for rendering HTML content.

.. versionadded:: 4.4
%End

%TypeHeaderCode
#include "qgshtmlrendersettings.h"
%End
  public:
    bool isEmpty() const;
%Docstring
Returns ``True`` no settings are set.
%End

    QUrl baseUrl() const;
%Docstring
Returns the base URL used when resolving relative links.

.. seealso:: :py:func:`setBaseUrl`
%End

    void setBaseUrl( const QUrl &url );
%Docstring
Sets the base ``url`` to use when resolving relative links.

.. seealso:: :py:func:`baseUrl`
%End

    void setUserStylesheet( const QString &stylesheet );
%Docstring
Sets the user ``stylesheet`` CSS rules to use while rendering the HTML
content.

These allow for overriding the styles specified within the HTML source.

.. seealso:: :py:func:`userStylesheet`
%End

    QString userStylesheet() const;
%Docstring
Returns the user stylesheet CSS rules used while rendering the HTML
content.

These overriding the styles specified within the HTML source.

.. seealso:: :py:func:`setUserStylesheet`
%End

    void setFeatureJson( const QVariantMap &json );
%Docstring
Sets the feature ``json``.

When the HTML has been loaded, an attempt will be made to call a
"setFeature" function, passing this custom json object.

.. seealso:: :py:func:`featureJson`
%End

    QVariantMap featureJson() const;
%Docstring
Returns the feature json.

When the HTML has been loaded, an attempt will be made to call a
"setFeature" function, passing this custom json object.

.. seealso:: :py:func:`setFeatureJson`
%End

    QVariantMap asMap() const;
%Docstring
Returns the settings encapsulated in a variantmap, for passing to the
qgis_html_to_pdf utility.
%End

};

