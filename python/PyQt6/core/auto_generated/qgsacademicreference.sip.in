class QgsAcademicReference
{
%Docstring(signature="appended")
Encapsulates an academic reference and formats it according to style
guidelines.

.. versionadded:: 4.4
%End

%TypeHeaderCode
#include "qgsacademicreference.h"
%End
  public:
