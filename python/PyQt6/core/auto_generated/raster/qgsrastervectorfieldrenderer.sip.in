class QgsRasterVectorFieldRenderer : QgsRasterRenderer
{
%Docstring(signature="appended")
Raster renderer which draws a vector field stored in raster bands.

The way that the raster data is interpreted as vectors (eg. Cartesian
component per band, single band with cardinal direction) can be set
using :py:func:`~setSourceMode`

.. versionadded:: 4.4
%End

%TypeHeaderCode
#include "qgsrastervectorfieldrenderer.h"
%End
  public:
    explicit QgsRasterVectorFieldRenderer( QgsRasterInterface *input );
%Docstring
Creates a vector field renderer
%End
