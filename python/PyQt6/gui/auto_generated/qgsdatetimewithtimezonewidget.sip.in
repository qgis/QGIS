class QgsTimeZoneWidget : QgsPanelWidget
{
%Docstring(signature="appended")
A widget for selection of available time zones.

The widget consists of a list of available time zones, along with a
filter widget for searching through the available zones.

.. versionadded:: 4.4
%End

%TypeHeaderCode
#include "qgsdatetimewithtimezonewidget.h"
%End
  public:
    explicit QgsTimeZoneWidget( QWidget *parent /TransferThis/ = 0 );
%Docstring
Constructor for QgsTimeZoneWidget, with the specified ``parent`` widget.
%End

    QTimeZone timeZone() const;
%Docstring
Returns the selected time zone.

An invalid time zone will be returned if no item is selected.

.. seealso:: :py:func:`setTimeZone`
%End

  public slots:

    void setTimeZone( const QTimeZone &zone );
%Docstring
Sets the current time zone to select in the widget.

.. seealso:: :py:func:`timeZone`
%End

