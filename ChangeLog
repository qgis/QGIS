    make_interval(days:=2, hours:=3)
    <interval: 2.125 days>

    make_interval(hours:=3,days:=1)
    <interval: 1.125 days>

    make_interval(minutes:=30)
    <interval: 30 minutes>

    make_interval(minutes:=0.5,seconds:=5)
    <interval: 35 seconds>

